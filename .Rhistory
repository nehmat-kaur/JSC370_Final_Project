library(readr)
library(httr)
library(jsonlite)
library(dplyr)
library(ggplot2)
library(kableExtra)
# DATA LOADING AND SAMPLING
# Load Kaggle dataset
spotify_raw <- read_csv("data/SpotifyFeatures.csv")
# Sample 300 unique tracks
set.seed(2025)
spotify_df <- spotify_raw %>%
select(track_id, track_name, artist_name, genre,
danceability, energy, valence, acousticness,
instrumentalness, liveness, loudness, speechiness,
tempo, duration_ms) %>%
distinct(track_id, .keep_all = TRUE) %>%
sample_n(300)
unique(spotify_raw$genre)
unique(colnames(spotify_raw))
# FETCHING POPULARITY SCORES FROM SPOTIFY API
# Spotify API Authentication
client_id <- "b254fcf60d234f3c98efa70ebeadcf3a"
client_secret <- "215958f394b842c1b1c70cf5c82ba08a"
auth_response <- POST(
url = "https://accounts.spotify.com/api/token",
accept_json(),
authenticate(client_id, client_secret),
body = list(grant_type = "client_credentials"),
encode = "form"
)
access_token <- content(auth_response)$access_token
# Fetch popularity for each sampled track
spotify_df$popularity <- NA
for (i in 1:nrow(spotify_df)) {
id <- spotify_df$track_id[i]
Sys.sleep(0.2)
track_url <- paste0("https://api.spotify.com/v1/tracks/", id)
resp <- GET(track_url, add_headers(Authorization = paste("Bearer", access_token)))
if (status_code(resp) == 200) {
track_data <- content(resp, as = "parsed", simplifyVector = TRUE)
spotify_df$popularity[i] <- track_data$popularity
} else {
spotify_df$popularity[i] <- NA
}
}
# DATA CLEANING
# Remove tracks with 0 popularity
spotify_clean <- spotify_df %>%
filter(!is.na(popularity)) %>%
filter(popularity > 0) %>%
mutate(duration_min = duration_ms / 60000) %>%
filter(duration_min <= 15) %>%
distinct()
spotify_clean$genre <- as.factor(spotify_clean$genre)
unique(spotify_clean$genre)
unique(colnames(spotify_clean))
unique(spotify_clean$artist_name)
library(corrplot)
# Calculate Spearman correlation matrix
cor_matrix <- cor(spotify_clean %>%
select(danceability, energy, valence, acousticness,
instrumentalness, liveness, loudness, speechiness,
tempo, popularity),
method = "spearman")
# Plot the correlation matrix
corrplot(cor_matrix, method = "color", type = "lower",
tl.cex = 0.8, addCoef.col = "black", number.cex = 0.7,
title = "Spearman Correlation Heatmap of Audio Features",
mar = c(0,0,2,0))
library(plotly)
library(reshape2)
# Compute Spearman correlation matrix
cor_matrix <- cor(spotify_clean %>%
select(danceability, energy, valence, acousticness,
instrumentalness, liveness, loudness, speechiness,
tempo, popularity),
method = "spearman")
# Melt for plotly
cor_melted <- melt(cor_matrix)
# Plotly heatmap
plot_ly(
data = cor_melted,
x = ~Var2,
y = ~Var1,
z = ~value,
type = "heatmap",
colorscale = "RdBu",
zmin = -1, zmax = 1
) %>%
layout(
title = "Interactive Spearman Correlation Heatmap of Audio Features",
xaxis = list(tickangle = 45),
yaxis = list(title = "")
)
set.seed(2025)
n <- nrow(spotify_clean)
train_indices_lm <- sample(1:n, size = 0.7 * n)
test_indices_lm <- setdiff(1:n, train_indices_lm)
spotify_train_lm <- spotify_clean[train_indices_lm, ]
spotify_test_lm <- spotify_clean[test_indices_lm, ]
spotify_train_lm$genre <- factor(spotify_train_lm$genre, levels = levels(spotify_clean$genre))
spotify_test_lm$genre <- factor(spotify_test_lm$genre, levels = levels(spotify_clean$genre))
is.factor(spotify_train_lm$genre)
is.factor(spotify_test_lm$genre)
levels(spotify_train_lm$genre)
levels(spotify_test_lm$genre)
table(spotify_train_lm$genre)
table(spotify_test_lm$genre)
test_genres <- unique(spotify_test_lm$genre)
train_genres <- unique(spotify_train_lm$genre)
setdiff(test_genres, train_genres)
lm_model <- lm(popularity ~ genre + danceability + energy + valence + acousticness +
instrumentalness + liveness + loudness + speechiness +
tempo,
data = spotify_train_lm)
predictions_lm <- predict(lm_model, newdata = spotify_test_lm)
set.seed(2025)
train_indices_rf <- sample(1:n, size = 0.6 * n)
remaining_indices_rf <- setdiff(1:n, train_indices_rf)
validation_indices_rf <- sample(remaining_indices_rf, size = 0.5 * length(remaining_indices_rf))
test_indices_rf <- setdiff(remaining_indices_rf, validation_indices_rf)
spotify_train_rf <- spotify_clean[train_indices_rf, ]
spotify_validation_rf <- spotify_clean[validation_indices_rf, ]
spotify_test_rf <- spotify_clean[test_indices_rf, ]
library(rpart)
library(rpart.plot)
tree_model <- rpart(popularity ~ genre + danceability + energy + valence + acousticness +
instrumentalness + liveness + loudness + speechiness +
tempo,
data = spotify_train_rf,
method = "anova")
rpart.plot(tree_model)
library(caret)
library(randomForest)
set.seed(2025)
train_control <- trainControl(method = "cv", number = 5)
rf_caret_model <- train(
popularity ~ genre + danceability + energy + valence + acousticness +
instrumentalness + liveness + loudness + speechiness +
tempo,
data = spotify_train_rf,
method = "rf",
trControl = train_control,
tuneLength = 5
)
rf_caret_model$bestTune
plot(rf_caret_model)
predictions_rf <- predict(rf_caret_model, newdata = spotify_test_rf)
test_rmse_rf <- sqrt(mean((spotify_test_rf$popularity - predictions_rf)^2))
test_rmse_rf
