library(readr)
library(httr)
library(jsonlite)
library(dplyr)
library(ggplot2)
library(kableExtra)
# Create a comparison data frame
rmse_df <- data.frame(
Model = c("Linear Regression", "Random Forest"),
RMSE = c(18.22, 17.94)
)
# Plot RMSEs
library(ggplot2)
ggplot(rmse_df, aes(x = Model, y = RMSE)) +
geom_col(fill = "steelblue") +
geom_text(aes(label = round(RMSE, 2)), vjust = -0.5) +
labs(
title = "Test RMSE Comparison Between Models",
y = "Root Mean Squared Error (RMSE)",
x = "Model"
) +
theme_minimal()
# Create a comparison data frame
rmse_df <- data.frame(
Model = c("Linear Regression", "Random Forest"),
RMSE = c(test_rmse_lm, test_rmse_rf)
)
# Plot RMSEs
library(ggplot2)
ggplot(rmse_df, aes(x = Model, y = RMSE)) +
geom_col(fill = "steelblue") +
geom_text(aes(label = round(RMSE, 2)), vjust = -0.5) +
labs(
title = "Test RMSE Comparison Between Models",
y = "Root Mean Squared Error (RMSE)",
x = "Model"
) +
theme_minimal()
# Load necessary libraries
library(caret)
library(randomForest)
# Set seed for reproducibility
set.seed(2025)
# Define cross-validation method
train_control <- trainControl(method = "cv", number = 5)
# Train a Random Forest model with 5-fold CV and tune mtry
rf_caret_model <- train(
popularity ~ genre + danceability + energy + valence + acousticness +
instrumentalness + liveness + loudness + speechiness + tempo,
data = spotify_train_rf,
method = "rf",
trControl = train_control,
tuneLength = 5
)
# Output the best tuning parameter
best_params <- rf_caret_model$bestTune
kable(best_params, caption = "Best Hyperparameter (mtry) Selected by Cross-Validation") %>%
kable_styling(full_width = FALSE)
# Output cross-validation results
cv_results <- rf_caret_model$results
kable(cv_results, caption = "Cross-Validation Results for Random Forest") %>%
kable_styling(full_width = FALSE)
# Plot RMSE vs mtry
plot(rf_caret_model)
predictions_rf <- predict(rf_caret_model, newdata = spotify_test_rf)
test_rmse_rf <- sqrt(mean((spotify_test_rf$popularity - predictions_rf)^2))
cat("Test RMSE (Random Forest):", round(test_rmse_rf, 2), "\n")
